{
  "name": "psl-agy-harness",
  "version": "0.1.0",
  "description": "Empirical audit and official extension harness for Google Antigravity",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "psl": "python3 -m harness.cli",
    "doctor": "python3 -m harness.cli doctor",
    "test": "python3 -m harness.cli test",
    "inventory": "python3 pipeline/inventory_customizations.py",
    "extract": "python3 pipeline/extract_transcripts.py",
    "classify": "python3 pipeline/classify_failures.py",
    "interventions": "python3 pipeline/summarize_interventions.py",
    "rules-audit": "python3 pipeline/audit_project_configs.py",
    "context-audit": "python3 pipeline/analyze_context_dynamics.py",
    "cognitive-audit": "python3 pipeline/extract_cognitive_traces.py",
    "artifacts-audit": "python3 pipeline/audit_artifacts.py",
    "audit": "npm run inventory && npm run extract && npm run classify && npm run rules-audit && npm run context-audit && npm run cognitive-audit && npm run artifacts-audit"
  },
  "keywords": [
    "antigravity",
    "gemini",
    "harness",
    "telemetry",
    "audit"
  ],
  "author": "Purrfect Software Limited (PSL)",
  "license": "Apache-2.0"
}
