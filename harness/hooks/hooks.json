{
  "psl-anti-drift-guard": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|create_file|insert_edit_into_file|write_to_file|replace_file_content|multi_replace_file_content|run_command|invoke_subagent|swarm|run_workflow|manage_subagents",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m harness.hooks.runner anti-drift",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "psl-anti-loop-guard": {
    "PreToolUse": [
      {
        "matcher": "read_file|view_file|grep_search|list_dir|find_by_name|run_command|manage_task|swarm|run_workflow|read_board|write_file|edit_file|create_file|insert_edit_into_file|write_to_file|replace_file_content|multi_replace_file_content|call_mcp_tool|list_resources|read_resource|update_focus|update_steps",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m harness.hooks.runner anti-loop",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "psl-command-safety-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|manage_task|manage_subagents|swarm|run_workflow|call_mcp_tool|mcp_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m harness.hooks.runner command-safety",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "psl-output-compactor": {
    "PostToolUse": [
      {
        "matcher": "run_command|read_file|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m harness.hooks.runner compactor",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "psl-stop-verification-fence": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|create_file|insert_edit_into_file|write_to_file|replace_file_content|multi_replace_file_content|run_command|execute_command|bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m harness.hooks.runner verification-fence",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|create_file|insert_edit_into_file|write_to_file|replace_file_content|multi_replace_file_content|run_command|execute_command|bash|call_mcp_tool|mcp_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m harness.hooks.runner post-verification-fence",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 -m harness.hooks.runner verification-fence",
        "timeout": 5
      }
    ]
  },
  "psl-token-proximity-guard": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m harness.hooks.runner token-proximity",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "psl-compaction-advisory": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 -m harness.hooks.runner pre-invocation",
        "timeout": 5
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 -m harness.hooks.runner pre-invocation",
        "timeout": 5
      }
    ]
  }
}
