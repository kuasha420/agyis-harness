{
  "psl-anti-drift-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m harness.cli hook anti-drift",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "psl-anti-loop-guard": {
    "PreToolUse": [
      {
        "matcher": "view_file|grep_search|run_command|manage_task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m harness.cli hook anti-loop",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "psl-command-safety-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m harness.cli hook command-safety",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "psl-output-compactor": {
    "PostToolUse": [
      {
        "matcher": "run_command|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m harness.cli hook compactor",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "psl-stop-verification-fence": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m harness.cli hook verification-fence",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 -m harness.cli hook verification-fence",
        "timeout": 5
      }
    ]
  }
}
