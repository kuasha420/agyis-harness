{
  "psl-anti-drift-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m harness.hooks.runner anti-drift",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "psl-anti-loop-guard": {
    "PreToolUse": [
      {
        "matcher": "view_file|grep_search|run_command|manage_task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m harness.hooks.runner anti-loop",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "psl-command-safety-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m harness.hooks.runner command-safety",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "psl-output-compactor": {
    "PostToolUse": [
      {
        "matcher": "run_command|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m harness.hooks.runner compactor",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "psl-stop-verification-fence": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m harness.hooks.runner verification-fence",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command|execute_command|bash|call_mcp_tool",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m harness.hooks.runner verification-fence",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 -m harness.hooks.runner verification-fence",
        "timeout": 5
      }
    ]
  },
  "psl-token-proximity-guard": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m harness.hooks.runner token-proximity",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
